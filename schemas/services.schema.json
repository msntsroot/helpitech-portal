{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Serviço do catálogo",
  "type": "object",
  "required": [
    "external_id",
    "name"
  ],
  "properties": {
    "external_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Preço por unidade de medida (R$)"
    },
    "unit": {
      "type": "string",
      "description": "hora, mês, ano, projeto…"
    },
    "est_units_year": {
      "type": "number",
      "minimum": 0,
      "description": "Unidades típicas por ano (estimativa de receita)"
    },
    "category": {
      "type": "string"
    },
    "target_segments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vazio = relevante para todos"
    }
  }
}